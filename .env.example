# ============================================================
# SEETHA AI - Developer environment file (OPTIONAL)
#
# Most users should NOT create this file - just open the app and
# use the  ⚙ Settings  window instead. Keys saved there live in
# %LOCALAPPDATA%/Seetha/settings.json on your machine.
#
# This .env exists for developers who prefer environment-style
# config. Settings-window values override .env values.
#
# Copy to `.env` and fill in what you have:   copy .env.example .env
# ============================================================

# --- AI Brain (at least one required for conversations) ---
# Free key: https://build.nvidia.com  (login -> any model -> Get API Key)
NVIDIA_API_KEY=
# Optional: override the default chat model (meta/llama-3.3-70b-instruct)
NIM_MODEL=
# Optional fallback brain. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# --- Deep Research add-ons (all optional) ---
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# https://api.nasa.gov
NASA_API_KEY=
# https://opensky-network.org
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
# https://trefle.io
TREFLE_API_TOKEN=
